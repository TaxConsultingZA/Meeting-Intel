# ==============================================================================
# BACKEND CONFIGURATION (.env in the root folder)
# ==============================================================================

# --- MICROSOFT ENTRA ID (Backend Pipeline) ---
# Used for Graph API access (OneDrive scans, Email sending)
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# API authentication: use entra outside local Mock development.
AUTH_MODE=entra
# Client ID of the Entra app registration that exposes access_as_user.
# Leave blank when it is the same as CLIENT_ID.
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=access_as_user

# --- DATABASE ---
# Format: postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://meeting:meeting@localhost:5434/meeting_intel

# --- AI SERVICES ---
# Microsoft Graph implementation: microsoft | mock
GRAPH_IMPL=microsoft

# Implementation: assemblyai | mock
TRANSCRIBER_IMPL=assemblyai
ASSEMBLYAI_API_KEY=

# Keep the real transcript but do not call a language model until one is selected.
# Options: transcript_only | azure_openai | mock (tests only) | gemini (opt-in)
EXTRACTOR_IMPL=transcript_only

# Gemini adapter is disabled by default. No key/model is supplied in this repo.
# Administrator must confirm access, model, billing and data policy before enabling.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Dedicated PostgreSQL worker; heartbeat must be shorter than lease expiry.
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=20
WORKER_SHUTDOWN_SECONDS=30
# Leave disabled in staging until real transcription is explicitly authorised.
RECORDING_PROCESSING_ENABLED=false

# --- INFRASTRUCTURE ---
# Service Bus Connection (Azure only)
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=meeting-jobs

# Master switch for emails
EMAILS_ENABLED=false
MAIL_SENDER_UPN=noreply@taxconsulting.co.za
ENABLE_AUTO_RECONCILE=false
# Deprecated: the explicit organiser approval endpoint is now the send gate.
AUTO_SEND_EMAIL=false
POPIA_NOTICE_ENABLED=true

# --- SECURITY & WEBHOOKS ---
ALLOWED_DOMAIN=taxconsulting.co.za
WEBHOOK_BASE_URL=https://your-ngrok-id.ngrok.app
WEBHOOK_CLIENT_STATE=
RECONCILE_SECRET=
SUBSCRIPTION_SECRET=

# ==============================================================================
# FRONTEND CONFIGURATION (Also uses the root .env or frontend/.env.local)
# ==============================================================================

# NextAuth Secret (Generate with: npx auth secret)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Microsoft Entra ID (Frontend Login)
AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=your-tenant-id

# Public API URL for the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
