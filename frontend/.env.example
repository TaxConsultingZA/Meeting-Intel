# Copy this file to .env.local for local development.
DATABASE_URL=postgresql://meeting:meeting@localhost:5434/meeting_intel
AUTH_SECRET=replace-with-a-long-random-local-secret
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Real Microsoft values are not needed for the local dev-login provider.
AUTH_MICROSOFT_ENTRA_ID_ID=mock-client
AUTH_MICROSOFT_ENTRA_ID_SECRET=mock-secret
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=mock-tenant
# Entra app registration exposing api://<id>/access_as_user.
# May be the same registration as AUTH_MICROSOFT_ENTRA_ID_ID.
AUTH_MICROSOFT_ENTRA_ID_API_ID=mock-client
NEXT_PUBLIC_HAS_RESEND=false
NEXT_PUBLIC_AUTH_MODE=mock
